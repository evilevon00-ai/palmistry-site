---
import { SITE_TITLE } from '../consts';
import BrandMark from './BrandMark.astro';
import HeaderLink from './HeaderLink.astro';
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<header>
	<nav aria-label="Site navigation">
		<p class="site-title">
		<a href="/">
			<BrandMark size={22} />
			{SITE_TITLE}
		</a>
	</p>
		<div class="internal-links">
			<HeaderLink href="/" data-track="nav" data-track-location="header" data-track-target="home">Home</HeaderLink>
			<HeaderLink href="/blog" data-track="nav" data-track-location="header" data-track-target="blog">Blog</HeaderLink>
			<HeaderLink href="/learn" data-track="nav" data-track-location="header" data-track-target="learn">Learn</HeaderLink>
			<HeaderLink href="/store" data-track="nav" data-track-location="header" data-track-target="store">Store</HeaderLink>
			<HeaderLink href="/about" data-track="nav" data-track-location="header" data-track-target="about">About</HeaderLink>
			<HeaderLink href="/glossary" data-track="nav" data-track-location="header" data-track-target="glossary">Glossary</HeaderLink>
			<HeaderLink href="/search" aria-label="Search" data-track="nav" data-track-location="header" data-track-target="search">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
			</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 1.5em;
		background: var(--color-header-bg);
		-webkit-backdrop-filter: blur(14px) saturate(1.2);
		backdrop-filter: blur(14px) saturate(1.2);
		border-bottom: 1px solid rgba(201, 169, 110, 0.14);
	}
	/* A hairline of light beneath the header, brighter at the centre */
	header::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 1px;
		background: linear-gradient(90deg, transparent 0%, rgba(201, 169, 110, 0.55) 50%, transparent 100%);
		pointer-events: none;
	}
	.site-title {
		margin: 0;
		font-size: 1em;
	}
	.site-title a,
	.site-title a.active {
		text-decoration: none;
		color: var(--accent-light);
		font-family: var(--font-cinzel), serif;
		letter-spacing: 0.12em;
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		text-shadow: 0 0 24px rgba(201, 169, 110, 0.25);
		transition: text-shadow 0.4s var(--ease-out);
	}
	.site-title a:hover {
		text-shadow: 0 0 32px rgba(201, 169, 110, 0.5);
	}
	.site-title :global(.brand-mark) {
		flex-shrink: 0;
		color: var(--accent);
		filter: drop-shadow(0 0 6px rgba(201, 169, 110, 0.45));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.4em 0;
		max-width: var(--wide);
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		min-width: 0;
	}
	nav a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		box-sizing: border-box;
		padding: 0.9em 0.6em;
		color: var(--color-nav-text);
		border-bottom: 1px solid transparent;
		text-decoration: none;
		font-size: 0.78em;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-family: var(--font-cinzel), serif;
		transition: color 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
	}
	nav a.active {
		border-bottom-color: var(--color-nav-hover);
		color: var(--color-nav-hover);
	}
	nav a:hover {
		color: var(--color-nav-hover);
	}

	@media (max-width: 1000px) {
		nav {
			flex-direction: column;
			align-items: center;
		}
	}

	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}
	}

	@media (max-width: 600px) {
		header {
			padding: 0;
			position: static;
		}
		nav {
			flex-direction: column;
			align-items: center;
			gap: 0;
			padding: 0.5em 1em 0;
		}
		.site-title {
			font-size: 0.95em;
		}
		.site-title a {
			padding: 0 0 0.4em;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.internal-links {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			width: 100%;
			border-top: 1px solid rgba(201, 169, 110, 0.08);
		}
		.internal-links a {
			padding: 0.9em 0.4em;
			font-size: 0.72em;
			letter-spacing: 0.06em;
		}
	}
</style>
