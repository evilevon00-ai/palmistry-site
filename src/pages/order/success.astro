---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`After Checkout — ${SITE_TITLE}`}
			description="Next steps after returning from Palmistry Path checkout."
			robots="noindex, follow"
		/>
		<style>
			main { box-sizing: border-box; width: var(--measure); max-width: 100%; margin: 0 auto; padding: 3em 1em; }
			.order-note { padding: 1.5em; border: 1px solid var(--hairline-strong); border-radius: 6px; background: var(--color-bg-elev); }
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" data-pagefind-ignore>
			<p class="eyebrow">After checkout</p>
			<h1 class="display">Thank you for visiting checkout.</h1>
			<div class="order-note">
				<p>This page cannot confirm payment or provide access to purchased files.</p>
				<p>If you completed payment, check the email address you used at checkout for your receipt and any separate delivery instructions. Check your spam folder too.</p>
				<p>If delivery instructions are missing, use the seller contact information shown in checkout or on your receipt. Check your payment status before purchasing again.</p>
			</div>
			<p><a href="/learn">Continue learning</a> · <a href="/store/">Return to the store</a></p>
		</main>
		<Footer />
	</body>
</html>
