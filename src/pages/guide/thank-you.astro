---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProductCard from '../../components/ProductCard.astro';
import { SITE_TITLE } from '../../consts';
import { products } from '../../products';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Your Guide Is on Its Way — ${SITE_TITLE}`}
			description="Your Quick Start Guide is on its way. Start with Lesson 1, explore beginner articles, or browse the Palmistry Path store."
			robots="noindex, follow"
		/>
		<style>
			/* ── Hero ─────────────────────────────────────────────────── */
			.thankyou-hero {
				position: relative;
				isolation: isolate;
				overflow: hidden;
				text-align: center;
				padding: 3.5em 1em 2.5em;
				background: radial-gradient(
					ellipse 65% 50% at 50% 40%,
					rgba(201, 169, 110, 0.07) 0%,
					transparent 70%
				);
			}
			.hero-art {
				position: absolute;
				inset: 0;
				z-index: -1;
				pointer-events: none;
			}
			.hero-art img {
				position: absolute;
				top: 50%;
				left: 50%;
				width: min(560px, 110vw);
				height: auto;
				transform: translate(-50%, -46%);
				opacity: 0.14;
				mask-image: radial-gradient(ellipse 50% 60% at 50% 50%, #000 25%, transparent 72%);
				-webkit-mask-image: radial-gradient(ellipse 50% 60% at 50% 50%, #000 25%, transparent 72%);
			}
			.hero-art::before {
				content: '';
				position: absolute;
				inset: 0;
				background:
					radial-gradient(ellipse 45% 60% at 50% 30%, rgba(122, 72, 201, 0.16), transparent 70%),
					linear-gradient(180deg, transparent 55%, var(--color-bg) 100%);
			}
			.hero-cover {
				display: block;
				width: 132px;
				height: auto;
				margin: 0 auto 1.6em;
				border: 1px solid var(--hairline-strong);
				border-radius: 3px;
				box-shadow: 0 24px 50px rgba(0, 0, 0, 0.6), 0 0 60px rgba(122, 72, 201, 0.2);
			}
			.thankyou-eyebrow {
				font-family: var(--font-cinzel), serif;
				font-size: 0.58em;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--color-text-muted);
				margin: 0 0 1.1em;
				opacity: 0.7;
			}
			.thankyou-hero h1 {
				font-size: clamp(1.6rem, 6vw, 3em);
				letter-spacing: 0.08em;
				color: var(--accent);
				text-shadow:
					0 0 80px rgba(201, 169, 110, 0.18),
					0 2px 8px rgba(0, 0, 0, 0.7);
				margin: 0 0 0.5em;
			}
			.thankyou-hero .subline {
				font-size: 0.9em;
				color: var(--color-text-muted);
				max-width: 480px;
				margin: 0 auto;
				line-height: 1.75;
			}

			/* ── Divider ──────────────────────────────────────────────── */
			.divider {
				text-align: center;
				color: var(--accent);
				letter-spacing: 0.5em;
				font-size: 0.6em;
				opacity: 0.45;
				padding: 2.5em 0 0;
				margin-bottom: 2.5em;
			}

			/* ── Shared section wrapper ───────────────────────────────── */
			.guide-section {
				width: 640px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 0 1em;
			}

			/* ── Section heading ──────────────────────────────────────── */
			.section-heading {
				font-family: var(--font-cinzel), serif;
				font-size: 0.62em;
				letter-spacing: 0.2em;
				text-transform: uppercase;
				color: var(--color-text-muted);
				opacity: 0.6;
				text-align: center;
				margin: 0 0 1.75em;
			}

			/* ── Next steps grid ──────────────────────────────────────── */
			.next-steps-grid {
				list-style: none;
				margin: 0 0 3.5em;
				padding: 0;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.25em 2em;
			}
			.next-steps-grid li {
				border-top: 1px solid rgba(201, 169, 110, 0.25);
				padding-top: 0.9em;
			}
			.step-link {
				display: block;
				text-decoration: none;
				transition: opacity 0.2s ease;
			}
			.step-link:hover {
				opacity: 0.85;
			}
			.step-link:hover .step-title {
				color: var(--accent-light, var(--accent));
			}
			.step-title {
				display: block;
				font-family: var(--font-cinzel), serif;
				font-size: 0.78em;
				letter-spacing: 0.06em;
				color: var(--accent);
				margin-bottom: 0.35em;
				line-height: 1.3;
				transition: color 0.2s ease;
			}
			.step-desc {
				display: block;
				font-size: 0.76em;
				color: var(--color-text-muted);
				line-height: 1.65;
				opacity: 0.8;
			}

			/* ── Footer note ──────────────────────────────────────────── */
			.footer-note {
				text-align: center;
				padding: 0 0 5em;
				border-top: 1px solid rgba(201, 169, 110, 0.1);
				margin-top: 1em;
				padding-top: 2.25em;
			}
			.footer-note p {
				font-size: 0.78em;
				color: var(--color-text-muted);
				opacity: 0.65;
				margin: 0;
				line-height: 1.7;
			}
			.footer-note a {
				color: var(--color-text-muted);
				text-decoration: underline;
				text-underline-offset: 2px;
				text-decoration-color: rgba(201, 169, 110, 0.3);
				transition: color 0.2s ease, text-decoration-color 0.2s ease;
			}
			.footer-note a:hover {
				color: var(--accent);
				text-decoration-color: rgba(201, 169, 110, 0.6);
			}

			/* ── Upsell block ─────────────────────────────────────────── */
			.product-next-steps {
				display: grid;
				gap: 1.25em;
			}
			.upsell-block {
				text-align: center;
				border: 1px solid rgba(201, 169, 110, 0.22);
				border-radius: 8px;
				background: rgba(255, 255, 255, 0.02);
				padding: 2em 1.5em 2.25em;
				margin-bottom: 3em;
			}
			.upsell-eyebrow {
				font-family: var(--font-cinzel), serif;
				font-size: 0.58em;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--accent);
				opacity: 0.75;
				margin: 0 0 0.75em;
			}
			.upsell-block h2 {
				font-size: clamp(1rem, 4vw, 1.4em);
				color: var(--color-heading);
				letter-spacing: 0.06em;
				margin: 0 0 0.5em;
			}
			.upsell-desc {
				font-size: 0.82em;
				color: var(--color-text-muted);
				max-width: 420px;
				margin: 0 auto 1.4em;
				line-height: 1.75;
			}
			.btn-upsell {
				display: inline-block;
				background: var(--accent);
				color: var(--color-bg);
				font-family: var(--font-cinzel), serif;
				font-size: 0.68em;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				text-decoration: none;
				padding: 0.85em 1.8em;
				border-radius: 4px;
				transition: background 0.2s ease, box-shadow 0.2s ease;
			}
			.btn-upsell:hover {
				background: var(--accent-light);
				box-shadow: 0 2px 14px rgba(201, 169, 110, 0.2);
				text-decoration: none;
			}
			.upsell-price {
				display: block;
				margin-top: 0.75em;
				font-size: 0.72em;
				color: var(--color-text-muted);
				opacity: 0.6;
			}

			/* ── Mobile ───────────────────────────────────────────────── */
			@media (max-width: 600px) {
				.thankyou-hero {
					padding: 3em 1em 2em;
				}
				.divider {
					padding-top: 1.75em;
					margin-bottom: 1.75em;
				}
				.next-steps-grid {
					grid-template-columns: 1fr;
					gap: 1.1em;
					margin-bottom: 2.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" data-pagefind-ignore>
			<section class="thankyou-hero">
				<div class="hero-art" aria-hidden="true"><img src="/images/home/hero-palm-map.webp" alt="" width="640" height="640" loading="eager" decoding="async" /></div>
				<img class="hero-cover reveal reveal--scale" src="/images/guide/quick-start-cover.webp" alt="" width="132" height="176" loading="eager" decoding="async" />
				<p class="thankyou-eyebrow reveal" style="--reveal-delay: 120ms">Palmistry Quick Start Guide</p>
				<h1 class="display reveal" style="--reveal-delay: 220ms">Your guide is on its way.</h1>
				<p class="subline reveal" style="--reveal-delay: 320ms">
					Check your inbox and spam folder for the guide. The email and PDF may still use the
					Starter Guide name. While you wait:
				</p>
			</section>

			<div class="divider" aria-hidden="true">✦ · ✦ · ✦</div>

			<div class="guide-section">
				<h2 class="section-heading">Where to begin</h2>
				<ul class="next-steps-grid">
					<li>
						<a
							href="/learn/foundations/01-what-palmistry-is"
							class="step-link"
							data-track="thankyou-lesson1"
						>
							<span class="step-title">Start with Lesson 1</span>
							<span class="step-desc"
								>Begin at the foundations — where palmistry starts and how to hold a reading.</span
							>
						</a>
					</li>
					<li>
						<a
							href="/blog/beginner/what-do-palm-lines-mean"
							class="step-link"
							data-track="thankyou-lines"
						>
							<span class="step-title">What do palm lines mean?</span>
							<span class="step-desc"
								>An introduction to the four major lines and what each tradition says about them.</span
							>
						</a>
					</li>
					<li style="grid-column: 1 / -1;">
						<a
							href="/blog/beginner/which-hand-to-read-palmistry"
							class="step-link"
							data-track="thankyou-hand"
						>
							<span class="step-title">Which hand should you read?</span>
							<span class="step-desc"
								>Active vs. passive hand — a practical guide for starting any reading.</span
							>
						</a>
					</li>
				</ul>
			</div>

			<div class="divider" aria-hidden="true">✦ · ✦ · ✦</div>

			<div class="guide-section">
				<div class="upsell-block">
					<p class="upsell-eyebrow">An optional next step</p>
					<h2>Continue your study</h2>
					<p class="upsell-desc">
						Your guide is free. Explore the Journal, Handbook, and Bundle whenever you're ready,
						or continue with the free lessons above.
					</p>
					<div class="product-next-steps">
						{products.map((product) => <ProductCard product={product} location="thankyou-products" />)}
					</div>
					<p><a href="/store/">Visit the store</a></p>
				</div>
			</div>

			<div class="guide-section footer-note">
				<p>
					The PDF download link is also available at <a href="/guide/">the guide page</a> if you'd
					prefer to download directly.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
